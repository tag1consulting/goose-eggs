     "content": {
      "size": 6048,
      "mimeType": "text/html",
      "text": "<!DOCTYPE html>\n\t<html lang=\"en-US\">\n\t<head>\n\t<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n\t<title>Log In &lsaquo; Theme Test Data &#8212; WordPress</title>\n\t<script>\nif(\"sessionStorage\" in window){try{for(var key in sessionStorage){if(key.indexOf(\"wp-autosave-\")!=-1){sessionStorage.removeItem(key)}}}catch(e){}};\n</script>\n<meta name='robots' content='max-image-preview:large, noindex, noarchive' />\n<link rel='stylesheet' href='http://localhost:18281/wp-admin/load-styles.php?c=0&amp;dir=ltr&amp;load%5Bchunk_0%5D=dashicons,buttons,forms,l10n,wp-base-styles,wp-tooltip,login&amp;ver=7.1.3' media='all' />\n\t<meta name='referrer' content='strict-origin-when-cross-origin' />\n\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\t\t</head>\n\t<body class=\"login no-js login-action-login wp-core-ui admin-color-modern locale-en-us\">\n\t<script>\ndocument.body.className = document.body.className.replace('no-js','js');\n</script>\n\n\t\t\t\t<h1 class=\"screen-reader-text\">Log In</h1>\n\t\t\t<div id=\"login\">\n\t\t<h1 role=\"presentation\" class=\"wp-login-logo\"><a href=\"https://wordpress.org/\">Powered by WordPress</a></h1>\n\t<div id=\"login-message\" class=\"notice notice-info message\"><p>You are now logged out.</p></div>\n\t\t<form name=\"loginform\" id=\"loginform\" action=\"http://localhost:18281/wp-login.php\" method=\"post\">\n\t\t\t<p>\n\t\t\t\t<label for=\"user_login\">Username or Email Address</label>\n\t\t\t\t<input type=\"text\" name=\"log\" id=\"user_login\" aria-describedby=\"login-message\" class=\"input ltr\" value=\"\" size=\"20\" autocapitalize=\"off\" autocomplete=\"username\" required=\"required\" />\n\t\t\t</p>\n\n\t\t\t<div class=\"user-pass-wrap\">\n\t\t\t\t<label for=\"user_pass\">Password</label>\n\t\t\t\t<div class=\"wp-pwd\">\n\t\t\t\t\t<input type=\"password\" name=\"pwd\" id=\"user_pass\" aria-describedby=\"login-message\" class=\"input password-input ltr\" value=\"\" size=\"20\" autocomplete=\"current-password\" spellcheck=\"false\" required=\"required\" />\n\t\t\t\t\t<button type=\"button\" class=\"button button-secondary wp-hide-pw hide-if-no-js\" data-toggle=\"0\" aria-label=\"Show password\">\n\t\t\t\t\t\t<span class=\"dashicons dashicons-visibility\" aria-hidden=\"true\"></span>\n\t\t\t\t\t</button>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<p class=\"forgetmenot\">\n\t\t\t\t<input name=\"rememberme\" type=\"checkbox\" id=\"rememberme\" value=\"forever\"  />\n\t\t\t\t<label for=\"rememberme\">Remember Me</label>\n\t\t\t\t<span class=\"wp-tooltip wp-is-toggletip\">\n\t\t\t\t<button aria-haspopup=\"dialog\" aria-label=\"Help\" class=\"wp-tooltip__toggle\" popovertarget=\"rememberme-help-toggletip\" type=\"button\"><span aria-hidden=\"true\" class=\"dashicons dashicons-editor-help\"></span></button>\n\t\t\t\t<span popover=\"auto\" id=\"rememberme-help-toggletip\" class=\"wp-tooltip__bubble\" role=\"dialog\" aria-label=\"Help\" tabindex=\"-1\" autofocus><span id=\"rememberme-help-toggletip-text\" class=\"wp-tooltip__text\">Selecting &quot;Remember Me&quot; increases the length of time until you&#8217;re asked to log in again on this device. To keep your account secure, use this option only on your personal devices.</span><button type=\"button\" class=\"wp-tooltip__close\" popovertarget=\"rememberme-help-toggletip\" popovertargetaction=\"hide\" aria-label=\"Close\"><span class=\"dashicons dashicons-no-alt\" aria-hidden=\"true\"></span></button></span></span>\t\t\t</p>\n\t\t\t<p class=\"submit\">\n\t\t\t\t<input type=\"submit\" name=\"wp-submit\" id=\"wp-submit\" class=\"button button-primary button-large\" value=\"Log In\" />\n\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"redirect_to\" value=\"http://localhost:18281/wp-admin/\" />\n\t\t\t\t\t\t\t\t\t<input type=\"hidden\" name=\"testcookie\" value=\"1\" />\n\t\t\t</p>\n\t\t</form>\n\n\t\t\t\t\t<p id=\"nav\">\n\t\t\t\t<a class=\"wp-login-lost-password\" href=\"http://localhost:18281/wp-login.php?action=lostpassword\">Lost your password?</a>\t\t\t</p>\n\t\t\t<script>\nfunction wp_attempt_focus() {setTimeout( function() {try {d = document.getElementById( \"user_login\" );d.focus(); d.select();} catch( er ) {}}, 200);}\nwp_attempt_focus();\nif ( typeof wpOnload === 'function' ) { wpOnload() }\n</script>\n\t\t<p id=\"backtoblog\">\n\t\t\t<a href=\"http://localhost:18281/\">&larr; Go to Theme Test Data</a>\t\t</p>\n\t\t\t</div>\n\t\t\n\t<script>\nvar _zxcvbnSettings = {\"src\":\"http://localhost:18281/wp-includes/js/zxcvbn.min.js\"};\n//# sourceURL=js-inline-concat-clipboard%2Cjquery-core%2Cjquery-migrate%2Czxcvbn-async%2Cwp-hooks\n</script>\n<script src=\"http://localhost:18281/wp-admin/load-scripts.php?c=0&#038;load%5Bchunk_0%5D=clipboard,jquery-core,jquery-migrate,zxcvbn-async,wp-hooks&#038;ver=7.1.3\"></script>\n<script id=\"wp-i18n-js\" src=\"http://localhost:18281/wp-includes/js/dist/i18n.min.js?ver=1dfe7db3940c23ea9216\"></script>\n<script id=\"wp-i18n-js-after\">\nwp.i18n.setLocaleData( { 'text direction\\u0004ltr': [ 'ltr' ] } );\n//# sourceURL=wp-i18n-js-after\n</script>\n<script id=\"password-strength-meter-js-extra\">\nvar pwsL10n = {\"unknown\":\"Password strength unknown\",\"short\":\"Very weak\",\"bad\":\"Weak\",\"good\":\"Medium\",\"strong\":\"Strong\",\"mismatch\":\"Mismatch\"};\n//# sourceURL=password-strength-meter-js-extra\n</script>\n<script id=\"password-strength-meter-js\" src=\"http://localhost:18281/wp-admin/js/password-strength-meter.min.js?ver=7.1.3\"></script>\n<script id=\"underscore-js\" src=\"http://localhost:18281/wp-includes/js/underscore.min.js?ver=1.13.8\"></script>\n<script id=\"wp-util-js-extra\">\nvar _wpUtilSettings = {\"ajax\":{\"url\":\"/wp-admin/admin-ajax.php\"}};\n//# sourceURL=wp-util-js-extra\n</script>\n<script id=\"wp-util-js\" src=\"http://localhost:18281/wp-includes/js/wp-util.min.js?ver=7.1.3\"></script>\n<script id=\"wp-dom-ready-js\" src=\"http://localhost:18281/wp-includes/js/dist/dom-ready.min.js?ver=3fe927cab37bf38d6a23\"></script>\n<script id=\"wp-a11y-js\" src=\"http://localhost:18281/wp-includes/js/dist/a11y.min.js?ver=31c6cec5a4ff7aff483d\"></script>\n<script id=\"user-profile-js-extra\">\nvar userProfileL10n = {\"user_id\":\"0\",\"nonce\":\"4417d9adcb\"};\n//# sourceURL=user-profile-js-extra\n</script>\n<script id=\"user-profile-js\" src=\"http://localhost:18281/wp-admin/js/user-profile.min.js?ver=7.1.3\"></script>\n<script id=\"wp-tooltip-js\" src=\"http://localhost:18281/wp-includes/js/wp-tooltip.js?ver=7.1.3\"></script>\n\t</body>\n\t</html>\n\t"
     },
