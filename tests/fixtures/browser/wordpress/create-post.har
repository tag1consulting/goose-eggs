brings history to life, making it accessible and engaging for a global audience.<\\/p>\\n\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\n\\t\\t\\t<!-- wp:group {\\\"style\\\":{\\\"spacing\\\":{\\\"blockGap\\\":\\\"var:preset|spacing|30\\\"}},\\\"layout\\\":{\\\"type\\\":\\\"flex\\\",\\\"orientation\\\":\\\"vertical\\\",\\\"flexWrap\\\":\\\"wrap\\\"}} -->\\n\\t\\t\\t<div class=\\\"wp-block-group\\\">\\n\\n\\t\\t\\t\\t<!-- wp:heading {\\\"level\\\":3,\\\"style\\\":{\\\"typography\\\":{\\\"textTransform\\\":\\\"uppercase\\\",\\\"letterSpacing\\\":\\\"1px\\\",\\\"fontStyle\\\":\\\"normal\\\",\\\"fontWeight\\\":\\\"600\\\"}},\\\"fontSize\\\":\\\"small\\\"} -->\\n\\t\\t\\t\\t<h3 class=\\\"wp-block-heading has-small-font-size\\\" style=\\\"font-style:normal;font-weight:600;letter-spacing:1px;text-transform:uppercase\\\">Subscribe on your favorite platform<\\/h3>\\n\\t\\t\\t\\t<!-- \\/wp:heading -->\\n\\n\\t\\t\\t\\t<!-- wp:group {\\\"layout\\\":{\\\"type\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"wrap\\\"}} -->\\n\\t\\t\\t\\t<div class=\\\"wp-block-group\\\">\\n\\t\\t\\t\\t\\t<!-- wp:paragraph {\\\"className\\\":\\\"is-style-text-annotation\\\"} -->\\n\\t\\t\\t\\t\\t<p class=\\\"is-style-text-annotation\\\"><a href=\\\"#\\\">YouTube<\\/a><\\/p>\\n\\t\\t\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\n\\t\\t\\t\\t\\t<!-- wp:paragraph {\\\"className\\\":\\\"is-style-text-annotation\\\"} -->\\n\\t\\t\\t\\t\\t<p class=\\\"is-style-text-annotation\\\"><a href=\\\"#\\\">Apple Podcasts<\\/a><\\/p>\\n\\t\\t\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\n\\t\\t\\t\\t\\t<!-- wp:paragraph {\\\"className\\\":\\\"is-style-text-annotation\\\"} -->\\n\\t\\t\\t\\t\\t<p class=\\\"is-style-text-annotation\\\"><a href=\\\"#\\\">Spotify<\\/a><\\/p>\\n\\t\\t\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\n\\t\\t\\t\\t\\t<!-- wp:paragraph {\\\"className\\\":\\\"is-style-text-annotation\\\"} -->\\n\\t\\t\\t\\t\\t<p class=\\\"is-style-text-annotation\\\"><a href=\\\"#\\\">Pocket Casts<\\/a><\\/p>\\n\\t\\t\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\n\\t\\t\\t\\t\\t<!-- wp:paragraph {\\\"className\\\":\\\"is-style-text-annotation\\\"} -->\\n\\t\\t\\t\\t\\t<p class=\\\"is-style-text-annotation\\\"><a href=\\\"#\\\">RSS<\\/a><\\/p>\\n\\t\\t\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\t\\t\\t\\t<\\/div>\\n\\t\\t\\t\\t<!-- \\/wp:group -->\\n\\n\\t\\t\\t<\\/div>\\n\\t\\t\\t<!-- \\/wp:group -->\\n\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:column -->\\n\\t<\\/div>\\n\\t<!-- \\/wp:columns -->\\n<\\/div>\\n<!-- \\/wp:group -->\\n<!-- wp:group {\\\"align\\\":\\\"full\\\",\\\"className\\\":\\\"is-style-section-5\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"padding\\\":{\\\"top\\\":\\\"var:preset|spacing|50\\\",\\\"bottom\\\":\\\"var:preset|spacing|50\\\"},\\\"margin\\\":{\\\"top\\\":\\\"0\\\",\\\"bottom\\\":\\\"0\\\"}}},\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"},\\\"metadata\\\":{\\\"patternName\\\":\\\"twentytwentyfive\\/heading-and-paragraph-with-image\\\",\\\"name\\\":\\\"Heading and paragraph with image on the right\\\",\\\"description\\\":\\\"A two-column section with a heading and paragraph on the left, and an image on the right.\\\",\\\"categories\\\":[\\\"about\\\"]}} -->\\n<div class=\\\"wp-block-group alignfull is-style-section-5\\\" style=\\\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\\\">\\n\\t<!-- wp:columns {\\\"align\\\":\\\"wide\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"blockGap\\\":{\\\"top\\\":\\\"var:preset|spacing|60\\\",\\\"left\\\":\\\"var:preset|spacing|80\\\"}}}} -->\\n\\t<div class=\\\"wp-block-columns alignwide\\\">\\n\\t\\t<!-- wp:column {\\\"verticalAlignment\\\":\\\"center\\\",\\\"width\\\":\\\"50%\\\"} -->\\n\\t\\t<div class=\\\"wp-block-column is-vertically-aligned-center\\\" style=\\\"flex-basis:50%\\\">\\n\\t\\t\\t<!-- wp:heading {\\\"className\\\":\\\"wp-block-heading\\\"} -->\\n\\t\\t\\t<h2 class=\\\"wp-block-heading\\\">\\n\\t\\t\\t\\tAbout the event\\t\\t\\t<\\/h2>\\n\\t\\t\\t<!-- \\/wp:heading -->\\n\\t\\t\\t<!-- wp:paragraph {\\\"fontSize\\\":\\\"medium\\\"} -->\\n\\t\\t\\t<p class=\\\"has-medium-font-size\\\">Held over a weekend, the event is structured around a series of exhibitions, workshops, and panel discussions. The exhibitions showcase a curated selection of photographs that tell compelling stories from various corners of the globe, each image accompanied by detailed narratives that provide context and deeper insight into the historical significance of the scenes depicted. These photographs are drawn from the archives of renowned photographers, as well as emerging talents, ensuring a blend of both classical and contemporary perspectives.<\\/p>\\n\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:column -->\\n\\n\\t\\t<!-- wp:column {\\\"verticalAlignment\\\":\\\"center\\\",\\\"width\\\":\\\"50%\\\",\\\"layout\\\":{\\\"type\\\":\\\"default\\\"}} -->\\n\\t\\t<div class=\\\"wp-block-column is-vertically-aligned-center\\\" style=\\\"flex-basis:50%\\\">\\n\\t\\t\\t<!-- wp:image {\\\"aspectRatio\\\":\\\"1\\\",\\\"scale\\\":\\\"cover\\\",\\\"sizeSlug\\\":\\\"full\\\"} -->\\n\\t\\t\\t<figure class=\\\"wp-block-image size-full\\\">\\n\\t\\t\\t\\t<img src=\\\"http:\\/\\/localhost:18281\\/wp-content\\/themes\\/twentytwentyfive\\/assets\\/images\\/ruins-image.webp\\\" alt=\\\"Cliff Palace, Colorado\\\" style=\\\"aspect-ratio:1;object-fit:cover\\\"\\/>\\n\\t\\t\\t<\\/figure>\\n\\t\\t\\t<!-- \\/wp:image -->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:column -->\\n\\t<\\/div>\\n\\t<!-- \\/wp:columns -->\\n<\\/div>\\n<!-- \\/wp:group -->\\n<!-- wp:group {\\\"align\\\":\\\"full\\\",\\\"className\\\":\\\"is-style-section-1\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"padding\\\":{\\\"top\\\":\\\"var:preset|spacing|80\\\",\\\"bottom\\\":\\\"var:preset|spacing|80\\\"},\\\"margin\\\":{\\\"top\\\":\\\"0\\\",\\\"bottom\\\":\\\"0\\\"}}},\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"},\\\"metadata\\\":{\\\"patternName\\\":\\\"twentytwentyfive\\/logos\\\",\\\"name\\\":\\\"Logos\\\",\\\"description\\\":\\\"Showcasing the podcast's clients with a heading and a series of client logos.\\\",\\\"categories\\\":[\\\"banner\\\"]}} -->\\n<div class=\\\"wp-block-group alignfull is-style-section-1\\\" style=\\\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--80);padding-bottom:var(--wp--preset--spacing--80)\\\">\\n\\t<!-- wp:heading {\\\"textAlign\\\":\\\"center\\\"} -->\\n\\t<h2 class=\\\"wp-block-heading has-text-align-center\\\">The Stories Podcast is sponsored by<\\/h2>\\n\\t<!-- \\/wp:heading -->\\n\\n\\t<!-- wp:spacer {\\\"height\\\":\\\"var:preset|spacing|30\\\"} -->\\n\\t<div style=\\\"height:var(--wp--preset--spacing--30)\\\" aria-hidden=\\\"true\\\" class=\\\"wp-block-spacer\\\"><\\/div>\\n\\t<!-- \\/wp:spacer -->\\n\\n\\t<!-- wp:group {\\\"align\\\":\\\"wide\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"blockGap\\\":\\\"var:preset|spacing|20\\\"}},\\\"layout\\\":{\\\"type\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"wrap\\\",\\\"justifyContent\\\":\\\"center\\\"}} -->\\n\\t<div class=\\\"wp-block-group alignwide\\\">\\n\\t\\t<!-- wp:image {\\\"width\\\":\\\"150px\\\",\\\"aspectRatio\\\":\\\"4\\/3\\\",\\\"scale\\\":\\\"contain\\\",\\\"linkDestination\\\":\\\"none\\\"} -->\\n\\t\\t<figure class=\\\"wp-block-image is-resized\\\"><img alt=\\\"\\\" style=\\\"aspect-ratio:4\\/3;object-fit:contain;width:150px\\\"\\/><\\/figure>\\n\\t\\t<!-- \\/wp:image -->\\n\\n\\t\\t<!-- wp:image {\\\"width\\\":\\\"150px\\\",\\\"aspectRatio\\\":\\\"4\\/3\\\",\\\"scale\\\":\\\"contain\\\",\\\"linkDestination\\\":\\\"none\\\"} -->\\n\\t\\t<figure class=\\\"wp-block-image is-resized\\\"><img alt=\\\"\\\" style=\\\"aspect-ratio:4\\/3;object-fit:contain;width:150px\\\"\\/><\\/figure>\\n\\t\\t<!-- \\/wp:image -->\\n\\n\\t\\t<!-- wp:image {\\\"width\\\":\\\"150px\\\",\\\"aspectRatio\\\":\\\"4\\/3\\\",\\\"scale\\\":\\\"contain\\\",\\\"linkDestination\\\":\\\"none\\\"} -->\\n\\t\\t<figure class=\\\"wp-block-image is-resized\\\"><img alt=\\\"\\\" style=\\\"aspect-ratio:4\\/3;