button__link has-text-align-center wp-element-button\\\">Subscribe<\\/a><\\/div>\\n\\t\\t<!-- \\/wp:button --><\\/div>\\n\\t\\t<!-- \\/wp:buttons -->\\n\\t<\\/div>\\n\\t<!-- \\/wp:group -->\\n<\\/aside>\\n<!-- \\/wp:group -->\\n\",\"description\":\"A landing page for the podcast with a hero section, description, logos, grid with videos and newsletter signup.\",\"viewport_width\":1400,\"categories\":[\"twentytwentyfive_page\",\"featured\"],\"keywords\":[\"starter\"],\"block_types\":[\"core\\/post-content\"],\"post_types\":[\"page\",\"wp_template\"]},{\"name\":\"twentytwentyfive\\/page-link-in-bio-heading-paragraph-links-image\",\"title\":\"Link in bio heading, paragraph, links and full-height image\",\"content\":\"<!-- wp:group {\\\"align\\\":\\\"full\\\",\\\"className\\\":\\\"is-style-section-4\\\",\\\"style\\\":{\\\"dimensions\\\":{\\\"minHeight\\\":\\\"100vh\\\"},\\\"spacing\\\":{\\\"margin\\\":{\\\"top\\\":\\\"0\\\",\\\"bottom\\\":\\\"0\\\"}}},\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"}} -->\\n<div class=\\\"wp-block-group alignfull is-style-section-4\\\" style=\\\"min-height:100vh;margin-top:0;margin-bottom:0\\\">\\n\\t<!-- wp:columns {\\\"align\\\":\\\"full\\\"} -->\\n\\t<div class=\\\"wp-block-columns alignfull\\\">\\n\\t\\t<!-- wp:column {\\\"verticalAlignment\\\":\\\"center\\\"} -->\\n\\t\\t<div class=\\\"wp-block-column is-vertically-aligned-center\\\">\\n\\t\\t\\t<!-- wp:group {\\\"style\\\":{\\\"spacing\\\":{\\\"padding\\\":{\\\"right\\\":\\\"var:preset|spacing|50\\\",\\\"left\\\":\\\"var:preset|spacing|50\\\",\\\"top\\\":\\\"var:preset|spacing|50\\\",\\\"bottom\\\":\\\"var:preset|spacing|50\\\"}}},\\\"layout\\\":{\\\"type\\\":\\\"default\\\"}} -->\\n\\t\\t\\t<div class=\\\"wp-block-group\\\" style=\\\"padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)\\\">\\n\\t\\t\\t\\t<!-- wp:heading -->\\n\\t\\t\\t\\t<h2 class=\\\"wp-block-heading\\\">Lewis Hine<\\/h2>\\n\\t\\t\\t\\t<!-- \\/wp:heading -->\\n\\n\\t\\t\\t\\t<!-- wp:paragraph -->\\n\\t\\t\\t\\t<p>Lewis W. Hine studied sociology before moving to New York in 1901 to work at the Ethical Culture School, where he took up photography to enhance his teaching practices<\\/p>\\n\\t\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\n\\t\\t\\t\\t<!-- wp:group {\\\"style\\\":{\\\"spacing\\\":{\\\"blockGap\\\":\\\"var:preset|spacing|20\\\"}},\\\"layout\\\":{\\\"type\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"nowrap\\\"}} -->\\n\\t\\t\\t\\t<div class=\\\"wp-block-group\\\">\\n\\t\\t\\t\\t\\t<!-- wp:paragraph -->\\n\\t\\t\\t\\t\\t<p><a href=\\\"#\\\">Instagram<\\/a><\\/p>\\n\\t\\t\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\n\\t\\t\\t\\t\\t<!-- wp:paragraph -->\\n\\t\\t\\t\\t\\t<p><a href=\\\"#\\\">X<\\/a><\\/p>\\n\\t\\t\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\n\\t\\t\\t\\t\\t<!-- wp:paragraph -->\\n\\t\\t\\t\\t\\t<p><a href=\\\"#\\\">TikTok<\\/a><\\/p>\\n\\t\\t\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\t\\t\\t\\t<\\/div>\\n\\t\\t\\t\\t<!-- \\/wp:group -->\\n\\t\\t\\t<\\/div>\\n\\t\\t\\t<!-- \\/wp:group -->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:column -->\\n\\n\\t\\t<!-- wp:column -->\\n\\t\\t<div class=\\\"wp-block-column\\\">\\n\\t\\t\\t<!-- wp:cover {\\\"url\\\":\\\"http:\\/\\/localhost:18281\\/wp-content\\/themes\\/twentytwentyfive\\/assets\\/images\\/link-in-bio-background.webp\\\",\\\"alt\\\":\\\"Photo of a woman worker.\\\",\\\"dimRatio\\\":0,\\\"customOverlayColor\\\":\\\"#6b6b6b\\\",\\\"isUserOverlayColor\\\":true,\\\"minHeight\\\":100,\\\"minHeightUnit\\\":\\\"vh\\\",\\\"layout\\\":{\\\"type\\\":\\\"default\\\"}} -->\\n\\t\\t\\t<div class=\\\"wp-block-cover\\\" style=\\\"min-height:100vh\\\"><span aria-hidden=\\\"true\\\" class=\\\"wp-block-cover__background has-background-dim-0 has-background-dim\\\" style=\\\"background-color:#6b6b6b\\\"><\\/span>\\n\\t\\t\\t\\t<img class=\\\"wp-block-cover__image-background\\\" alt=\\\"Photo of a woman worker.\\\" src=\\\"http:\\/\\/localhost:18281\\/wp-content\\/themes\\/twentytwentyfive\\/assets\\/images\\/link-in-bio-background.webp\\\" data-object-fit=\\\"cover\\\"\\/><div class=\\\"wp-block-cover__inner-container\\\">\\n\\t\\t\\t\\t<!-- wp:spacer {\\\"height\\\":\\\"var:preset|spacing|20\\\"} -->\\n\\t\\t\\t\\t<div style=\\\"height:var(--wp--preset--spacing--20)\\\" aria-hidden=\\\"true\\\" class=\\\"wp-block-spacer\\\"><\\/div>\\n\\t\\t\\t\\t<!-- \\/wp:spacer -->\\n\\t\\t\\t<\\/div><\\/div>\\n\\t\\t\\t<!-- \\/wp:cover -->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:column -->\\n\\t<\\/div>\\n\\t<!-- \\/wp:columns -->\\n<\\/div>\\n<!-- \\/wp:group -->\\n\",\"description\":\"A link in bio landing page with a heading, paragraph, links and a full height image.\",\"viewport_width\":1400,\"categories\":[\"twentytwentyfive_page\",\"banner\",\"featured\"],\"keywords\":[\"starter\"],\"block_types\":[\"core\\/post-content\"]},{\"name\":\"twentytwentyfive\\/page-link-in-bio-wide-margins\",\"title\":\"Link in bio with profile, links and wide margins\",\"content\":\"<!-- wp:group {\\\"align\\\":\\\"full\\\",\\\"className\\\":\\\"is-style-section-1\\\",\\\"style\\\":{\\\"dimensions\\\":{\\\"minHeight\\\":\\\"100vh\\\"},\\\"spacing\\\":{\\\"padding\\\":{\\\"right\\\":\\\"var:preset|spacing|80\\\",\\\"left\\\":\\\"var:preset|spacing|80\\\",\\\"top\\\":\\\"var:preset|spacing|80\\\",\\\"bottom\\\":\\\"var:preset|spacing|80\\\"},\\\"margin\\\":{\\\"top\\\":\\\"0\\\",\\\"bottom\\\":\\\"0\\\"}}},\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"}} -->\\n<div class=\\\"wp-block-group alignfull is-style-section-1\\\" style=\\\"min-height:100vh;margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--80);padding-right:var(--wp--preset--spacing--80);padding-bottom:var(--wp--preset--spacing--80);padding-left:var(--wp--preset--spacing--80)\\\">\\n\\t<!-- wp:columns {\\\"verticalAlignment\\\":\\\"center\\\",\\\"align\\\":\\\"wide\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"blockGap\\\":{\\\"top\\\":\\\"var:preset|spacing|6