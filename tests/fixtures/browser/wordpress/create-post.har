yout\\\":{\\\"type\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"right\\\",\\\"orientation\\\":\\\"vertical\\\"}} \\/-->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:group -->\\n\\t<\\/div>\\n\\t<!-- \\/wp:group -->\\n<\\/div>\\n<!-- \\/wp:group -->\\n\",\"description\":\"Site header with large site title and right-aligned navigation.\",\"categories\":[\"header\"],\"block_types\":[\"core\\/template-part\\/header\"]},{\"name\":\"twentytwentyfive\\/header\",\"title\":\"Header\",\"content\":\"<!-- wp:group {\\\"align\\\":\\\"full\\\",\\\"layout\\\":{\\\"type\\\":\\\"default\\\"}} -->\\n<div class=\\\"wp-block-group alignfull\\\">\\n\\t<!-- wp:group {\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"}} -->\\n\\t<div class=\\\"wp-block-group\\\">\\n\\t\\t<!-- wp:group {\\\"align\\\":\\\"wide\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"padding\\\":{\\\"top\\\":\\\"var:preset|spacing|30\\\",\\\"bottom\\\":\\\"var:preset|spacing|30\\\"}}},\\\"layout\\\":{\\\"type\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"nowrap\\\",\\\"justifyContent\\\":\\\"space-between\\\"}} -->\\n\\t\\t<div class=\\\"wp-block-group alignwide\\\" style=\\\"padding-top:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--30)\\\">\\n\\t\\t\\t<!-- wp:site-title {\\\"level\\\":0} \\/-->\\n\\t\\t\\t<!-- wp:group {\\\"style\\\":{\\\"spacing\\\":{\\\"blockGap\\\":\\\"var:preset|spacing|10\\\"}},\\\"layout\\\":{\\\"type\\\":\\\"flex\\\",\\\"flexWrap\\\":\\\"nowrap\\\",\\\"justifyContent\\\":\\\"right\\\"}} -->\\n\\t\\t\\t<div class=\\\"wp-block-group\\\">\\n\\t\\t\\t\\t<!-- wp:navigation {\\\"overlayBackgroundColor\\\":\\\"base\\\",\\\"overlayTextColor\\\":\\\"contrast\\\",\\\"layout\\\":{\\\"type\\\":\\\"flex\\\",\\\"justifyContent\\\":\\\"right\\\",\\\"flexWrap\\\":\\\"wrap\\\"}} \\/-->\\n\\t\\t\\t<\\/div>\\n\\t\\t\\t<!-- \\/wp:group -->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:group -->\\n\\t<\\/div>\\n\\t<!-- \\/wp:group -->\\n<\\/div>\\n<!-- \\/wp:group -->\\n\",\"description\":\"Site header with site title and navigation.\",\"categories\":[\"header\"],\"block_types\":[\"core\\/template-part\\/header\"]},{\"name\":\"twentytwentyfive\\/heading-and-paragraph-with-image\",\"title\":\"Heading and paragraph with image on the right\",\"content\":\"\\n<!-- wp:group {\\\"align\\\":\\\"full\\\",\\\"className\\\":\\\"is-style-section-5\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"padding\\\":{\\\"top\\\":\\\"var:preset|spacing|50\\\",\\\"bottom\\\":\\\"var:preset|spacing|50\\\"},\\\"margin\\\":{\\\"top\\\":\\\"0\\\",\\\"bottom\\\":\\\"0\\\"}}},\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"}} -->\\n<div class=\\\"wp-block-group alignfull is-style-section-5\\\" style=\\\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50)\\\">\\n\\t<!-- wp:columns {\\\"align\\\":\\\"wide\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"blockGap\\\":{\\\"top\\\":\\\"var:preset|spacing|60\\\",\\\"left\\\":\\\"var:preset|spacing|80\\\"}}}} -->\\n\\t<div class=\\\"wp-block-columns alignwide\\\">\\n\\t\\t<!-- wp:column {\\\"verticalAlignment\\\":\\\"center\\\",\\\"width\\\":\\\"50%\\\"} -->\\n\\t\\t<div class=\\\"wp-block-column is-vertically-aligned-center\\\" style=\\\"flex-basis:50%\\\">\\n\\t\\t\\t<!-- wp:heading {\\\"className\\\":\\\"wp-block-heading\\\"} -->\\n\\t\\t\\t<h2 class=\\\"wp-block-heading\\\">\\n\\t\\t\\t\\tAbout the event\\t\\t\\t<\\/h2>\\n\\t\\t\\t<!-- \\/wp:heading -->\\n\\t\\t\\t<!-- wp:paragraph {\\\"fontSize\\\":\\\"medium\\\"} -->\\n\\t\\t\\t<p class=\\\"has-medium-font-size\\\">Held over a weekend, the event is structured around a series of exhibitions, workshops, and panel discussions. The exhibitions showcase a curated selection of photographs that tell compelling stories from various corners of the globe, each image accompanied by detailed narratives that provide context and deeper insight into the historical significance of the scenes depicted. These photographs are drawn from the archives of renowned photographers, as well as emerging talents, ensuring a blend of both classical and contemporary perspectives.<\\/p>\\n\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:column -->\\n\\n\\t\\t<!-- wp:column {\\\"verticalAlignment\\\":\\\"center\\\",\\\"width\\\":\\\"50%\\\",\\\"layout\\\":{\\\"type\\\":\\\"default\\\"}} -->\\n\\t\\t<div class=\\\"wp-block-column is-vertically-aligned-center\\\" style=\\\"flex-basis:50%\\\">\\n\\t\\t\\t<!-- wp:image {\\\"aspectRatio\\\":\\\"1\\\",\\\"scale\\\":\\\"cover\\\",\\\"sizeSlug\\\":\\\"full\\\"} -->\\n\\t\\t\\t<figure class=\\\"wp-block-image size-full\\\">\\n\\t\\t\\t\\t<img src=\\\"http:\\/\\/localhost:18281\\/wp-content\\/themes\\/twentytwentyfive\\/assets\\/images\\/ruins-image.webp\\\" alt=\\\"Cliff Palace, Colorado\\\" style=\\\"aspect-ratio:1;object-fit:cover\\\"\\/>\\n\\t\\t\\t<\\/figure>\\n\\t\\t\\t<!-- \\/wp:image -->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:column -->\\n\\t<\\/div>\\n\\t<!-- \\/wp:columns -->\\n<\\/div>\\n<!-- \\/wp:group -->\\n\",\"description\":\"A two-column section with a heading and paragraph on the left, and an image on the right.\",\"categories\":[\"about\"]},{\"name\":\"twentytwentyfive\\/hero-book\",\"title\":\"Hero book\",\"content\":\"<!-- wp:group {\\\"align\\\":\\\"full\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"margin\\\":{\\\"top\\\":\\\"0\\\",\\\"bottom\\\":\\\"0\\\"}}},\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"}} -->\\n<div class=\\\"wp-block-group alignfull\\\" style=\\\"margin-top:0;margin-bottom:0\\\">\\n\\t<!-- wp:columns {\\\"align\\\":\\\"full\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"blockGap\\\":{\\\"left\\\":\\\"0\\\"}}}} -->\\n\\t<div class=\\\"wp-block-columns alignfull\\\">\\n\\t\\t<!-- wp:column {\\\"width\\\":\\\"55%\\\"} -->\\n\\t\\t<div class=\\\"wp-block-column\\\" style=\\\"flex-basis:55%\\\">\\n\\t\\t\\t<!-- wp:cover {\\\"url\\\":\\\"http:\\/\\/localhost:18281\\/wp-content\\/themes\\/twentytwentyfive\\/assets\\/images\\/book-image-landing.webp\\\",\\\"dimRatio\\\":0,\\\"customOverlayColor\\\":\\\"#6b6b6b\\\",\\\"isUserOverlayColor\\\":true,\\\"isDark\\\":false,\\\"style\\\":{\\\"dimensions\\\":{\\\"aspectRatio\\\":\\\"1\\\"}},\\\"layout\\\":{\\\"type\\\":\\\"default\\\"}} -->\\n\\t\\t\\t<div class=\\\"wp-block-cover is-light\\\">\\n\\t\\t\\t\\t<span aria-hidden=\\\"true\\\" class=\\\"wp-block-cover__background has-background-dim-0 has-background-dim\\\" style=\\\"background-color:#6b6b6b\\\"><\\/span>\\n\\t\\t\\t\\t<img class=\\\"wp-block-cover__image-background\\\" alt=\\\"Image of the book\\\" src=\\\"http:\\/\\/localhost:18281\\/wp-content\\/themes\\/twentytwentyfive\\/assets\\/images\\/book-image-landing.webp\\\" data-object-fit=\\\"cover\\\"\\/>\\n\\t\\t\\t\\t<div class=\\\"wp-block-cover__inner-container\\\">\\n\\t\\t\\t\\t\\t<!-- wp:spacer {\\\"height\\\":\\\"var:preset|spacing|20\\\"} -->\\n\\t\\t\\t\\t\\t<div style=\\\"height:var(--wp--preset--spacing--20)\\\" aria-hidden=\\\"true\\\" class=\\\"wp-block-spacer\\\"><\\/div>\\n\\t\\t\\t\\t\\t<!-- \\/wp:spacer -->\\n\\t\\t\\t\\t<\\/div>\\n\\t\\t\\t<\\/div>\\n\\t\\t\\t<!-- \\/wp:cover -->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:column -->\\n\\n<!-- wp:column {\\\"verticalAlignment\\\":\\\"center\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"padding\\\":{\\\"top\\\":\\\"var:preset|spacing|60\\\",\\\"bottom\\\":\\\"var:preset|spacing|60\\\",\\\"left\\\":\\\"var:preset|spacing|60\\\",\\\"right\\\":\\\"var:preset|spacing|60\\\"}}}} -->\\n<div class=\\\"wp-block-column is-vertically-aligned-center\\\" style=\\\"padding-top:var(--wp--preset--spacing--60);padding-right:var(--wp--preset--spacing--60);padding-bottom:var(--wp--preset--spacing--60);padding-left:var(--wp--preset--spacing--60)\\\">\\n<!-- wp:heading -->\\n<h2 class=\\\"wp-block-heading has-xx-large-font-size\\\">The Stories Book<\\/h2>\\n<!-- \\/wp:heading -->\\n\\n<!-- wp:paragraph -->\\n<p>A fine collection of moments in time featuring photographs from Louis Fleckenstein, Paul Strand and Asahachi K\\u014dno.<\\/p>\\n<!-- \\/wp:paragraph -->\\n\\n<!-- wp:paragraph {\\\"fontSize\\\":\\\"medium\\\"} -->\\n<p class=\\\"has-medium-font-size\\\">Available for pre-order now.<\\/p>\\n<!-- \\/wp:paragraph --><\\/div>\\n<!-- \\/wp:column --><\\/div>\\n<!-- \\/wp:columns --><\\/div>\\n<!-- \\/wp:group -->\\n\",\"description\":\"A hero section for the book with a description and pre-order link.\",\"categories\":[\"banner\"],\"keywords\":[\"podcast\",\"hero\",\"stories\"]},{\"name\":\"twentytwentyfive\\/hero-full-width-image\",\"title\":\"Hero, full width image\",\"content\":\"\\n<!-- wp:cover {\\\"url\\\":\\\"http:\\/\\/localhost:18281\\/wp-content\\/themes\\/twentytwentyfive\\/assets\\/images\\/northern-buttercups-flowers.webp\\\",\\\"alt\\\":\\\"Picture of a flower\\\",\\\"dimRatio\\\":10,\\\"isUserOverlayColor\\\":true,\\\"focalPoint\\\":{\\\"x\\\":0.5,\\\"y\\\":0.95},\\\"minHeight\\\":840,\\\"minHeightUnit\\\":\\\"px\\\",\\\"contentPosition\\\":\\\"bottom center\\\",\\\"align\\\":\\\"full\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"padding\\\":{\\\"top\\\":\\\"var:preset|spacing|50\\\",\\\"bottom\\\":\\\"var:preset|spacing|50\\\",\\\"left\\\":\\\"var:preset|spacing|50\\\",\\\"right\\\":\\\"var:preset|spacing|50\\\"},\\\"margin\\\":{\\\"top\\\":\\\"0\\\",\\\"bottom\\\":\\\"0\\\"}}},\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"}} -->\\n<div class=\\\"wp-block-cover alignfull has-custom-content-position is-position-bottom-center\\\" style=\\\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50);min-height:840px\\\">\\n\\t<span aria-hidden=\\\"true\\\" class=\\\"wp-block-cover__background has-background-dim-10 has-background-dim\\\"><\\/span>\\n\\t<img class=\\\"wp-block-cover__image-background\\\" alt=\\\"Picture of a flower\\\" src=\\\"http:\\/\\/localhost:18281\\/wp-content\\/themes\\/twentytwentyfive\\/assets\\/images\\/northern-buttercups-flowers.webp\\\" style=\\\"object-position:50% 95%\\\" data-object-fit=\\\"cover\\\" data-object-position=\\\"50% 95%\\\"\\/>\\n\\t<div class=\\\"wp-block-cover__inner-container\\\">\\n\\t\\t<!-- wp:group {\\\"align\\\":\\\"wide\\\",\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\",\\\"justifyContent\\\":\\\"left\\\"}} -->\\n\\t\\t<div class=\\\"wp-block-group alignwide\\\">\\n\\t\\t\\t<!-- wp:heading {\\\"textAlign\\\":\\\"left\\\",\\\"fontSize\\\":\\\"xx-large\\\"} -->\\n\\t\\t\\t<h2 class=\\\"wp-block-heading has-text-align-left has-xx-large-font-size\\\">Tell your story<\\/h2>\\n\\t\\t\\t<!-- \\/wp:heading -->\\n\\n\\t\\t\\t<!-- wp:paragraph -->\\n\\t\\t\\t<p>Like flowers that bloom in unexpected places, every story unfolds with beauty and resilience, revealing hidden wonders.<\\/p>\\n\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\n\\t\\t\\t<!-- wp:buttons -->\\n\\t\\t\\t<div class=\\\"wp-block-buttons\\\">\\n\\t\\t\\t\\t<!-- wp:button -->\\n\\t\\t\\t\\t<div class=\\\"wp-block-button\\\"><a class=\\\"wp-block-button__link wp-element-button\\\">Learn more<\\/a><\\/div>\\n\\t\\t\\t\\t<!-- \\/wp:button -->\\n\\t\\t\\t<\\/div>\\n\\t\\t\\t<!-- \\/wp:buttons -->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:group -->\\n\\t<\\/div>\\n<\\/div>\\n<!-- \\/wp:cover -->\\n\",\"description\":\"A hero with a full width image, heading, short paragraph and button.\",\"categories\":[\"banner\"]},{\"name\":\"twentytwentyfive\\/hero-overlapped-book-cover-with-links\",\"title\":\"Hero, overlapped book cover with links\",\"content\":\"<!-- wp:group {\\\"align\\\":\\\"full\\\",\\\"className\\\":\\\"is-style-section-1\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"padding\\\":{\\\"top\\\":\\\"var:preset|spacing|80\\\",\\\"bottom\\\":\\\"var:preset|spacing|80\\\",\\\"left\\\":\\\"var:preset|spacing|50\\\",\\\"right\\\":\\\"var:preset|spacing|50\\\"},\\\"margin\\\":{\\\"top\\\":\\\"0\\\",\\\"bottom\\\":\\\"0\\\"}}},\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"}} -->\\n<div class=\\\"wp-block-group alignfull is-style-se