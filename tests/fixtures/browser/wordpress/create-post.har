ontent\\\":\\\"left\\\"}} -->\\n\\t\\t\\t\\t\\t<div class=\\\"wp-block-group\\\">\\n\\t\\t\\t\\t\\t\\t<!-- wp:heading {\\\"level\\\":3,\\\"style\\\":{\\\"typography\\\":{\\\"fontStyle\\\":\\\"normal\\\",\\\"fontWeight\\\":\\\"500\\\"}},\\\"fontSize\\\":\\\"large\\\"} -->\\n\\t\\t\\t\\t\\t\\t<h3 class=\\\"wp-block-heading has-large-font-size\\\" style=\\\"font-style:normal;font-weight:500\\\">United Kingdom<\\/h3>\\n\\t\\t\\t\\t\\t\\t<!-- \\/wp:heading -->\\n\\n\\t\\t\\t\\t\\t\\t<!-- wp:paragraph {\\\"fontSize\\\":\\\"medium\\\"} -->\\n\\t\\t\\t\\t\\t\\t<p class=\\\"has-medium-font-size\\\"><a href=\\\"#\\\">Book Store<\\/a><\\/p>\\n\\t\\t\\t\\t\\t\\t<!-- \\/wp:paragraph -->\\n\\t\\t\\t\\t\\t<\\/div>\\n\\t\\t\\t\\t\\t<!-- \\/wp:group -->\\n\\t\\t\\t\\t<\\/div>\\n\\t\\t\\t\\t<!-- \\/wp:column -->\\n\\t\\t\\t<\\/div>\\n\\t\\t\\t<!-- \\/wp:columns -->\\n\\t\\t<\\/div>\\n\\t\\t<!-- \\/wp:column -->\\n\\t<\\/div>\\n\\t<!-- \\/wp:columns -->\\n<\\/div>\\n<!-- \\/wp:group -->\\n\",\"description\":\"A call to action section with links to get the book in the most popular locations.\",\"categories\":[\"call-to-action\"]},{\"name\":\"twentytwentyfive\\/cta-centered-heading\",\"title\":\"Centered heading\",\"content\":\"<!-- wp:group {\\\"align\\\":\\\"full\\\",\\\"style\\\":{\\\"spacing\\\":{\\\"padding\\\":{\\\"right\\\":\\\"var:preset|spacing|40\\\",\\\"left\\\":\\\"var:preset|spacing|40\\\",\\\"top\\\":\\\"var:preset|spacing|70\\\",\\\"bottom\\\":\\\"var:preset|spacing|70\\\"},\\\"margin\\\":{\\\"top\\\":\\\"0\\\",\\\"bottom\\\":\\\"0\\\"}},\\\"dimensions\\\":{\\\"minHeight\\\":\\\"0vh\\\"}},\\\"layout\\\":{\\\"type\\\":\\\"constrained\\\"}} -->\\n<div class=\\\"wp-block-group alignfull\\\" style=\\\"min-height:0vh;margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--70);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--70);padding-left:var(--wp--preset--spacing--40)\\\">\\n\\t<!-- wp:group {\\\"style\\\":{\\\"spacing\\\":{